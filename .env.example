# Copiar este archivo a .env.local y completar. NUNCA subir .env.local al repositorio.
# En Vercel, configurar estas mismas variables en Project Settings → Environment Variables.

# Neon: URL "pooled" (host con -pooler) para la app
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/el_maseta?sslmode=require
# Neon: URL directa (sin -pooler) para migraciones con drizzle-kit
DATABASE_URL_DIRECTA=postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/el_maseta?sslmode=require

# Clave para firmar las sesiones JWT (mínimo 32 caracteres aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Duración máxima de la sesión en horas
SESION_HORAS=12

# Vercel Blob (fotos de productos, QR, comprobantes) — Fase 2
BLOB_READ_WRITE_TOKEN=

# Sentry (monitoreo de errores) — opcional hasta producción
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# PIN inicial del administrador creado por el seed (cámbialo al primer ingreso)
SEED_ADMIN_USUARIO=admin
SEED_ADMIN_PIN=
